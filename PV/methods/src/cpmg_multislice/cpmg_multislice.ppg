;===============================================================================
;=
;= $Source$
;=
;= A CPMG experiment with a 1D readout gradient and multiple slices
;=
;= $Id$
;===============================================================================

; l2: loop counter for dummy loop

#include <MRI.include>

;===============================================================================
;   definition of delays and frequency lists
;===============================================================================

define delay denab
"denab =  d1 - de"

define list<frequency> freqTx = {$ACQ_O1_list}
define list<frequency> freqRx = {$ACQ_O1B_list}
define list<frequency> freqZero = {0}

INIT_DEVICES

;===============================================================================
;	D/P               spec control          gradients	         
;===============================================================================
start, 	10u               freqRx(receive):f1
 	d1		  freqTx:f1             grad_ramp{0, 0, g0}	 	         
        (p0:sp0 ph0):f1
	d1					     grad_off
	d3                                      grad_ramp{g2, 0, g1}
	d1		                        grad_off

; Refocusing
echoes, 10u               freqZero:f1
    			  (p1:sp1 ph2):f1
        10u
	denab                       	        grad_ramp{g5, 0, 0} 
	                  ADC_INIT_(job0, ph1, ph0)  
	AQ_(job0)         ADC_START_(job0)
	                  ADC_END_(job0)               
	d1 		                        grad_off

lo to echoes times NEchoes
	d0                                      grad_matrix.inc
        0u                freqTx.inc
        0u                freqRx.inc
lo to start times NSLICES
                          "l2=l2-1"
if "l2>=0" goto start
        0u                ipp2
lo to start times NA
SETUP_GOTO(start) 
exit
;===============================================================================
;phase lists

ph0 = 0
ph1 = 1
ph2 = 1  3
;===============================================================================
